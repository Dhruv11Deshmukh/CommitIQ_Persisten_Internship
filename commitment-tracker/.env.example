# Copy this file to commitment-tracker/.env and fill in YOUR OWN values. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commitments

# --- AI ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- Who the commitments belong to (use your own name) ---
OWNER_NAME=Your Name

# --- Sources to read: gmail, file (drop folder), teams (optional) ---
ENABLED_SOURCES=gmail,file
FILE_DROP_DIR=./drop
FILE_DROP_POLL_SECONDS=5

# --- Features ---
MEETINGS_ENABLED=true
BRIEF_HOUR=8
DEP_AUTO_CONFIDENCE=0.75
DEP_BACKFILL_DAYS=7

# --- Google sign-in / Gmail / Calendar (needed for the gmail source and meetings) ---
# Download your own OAuth client JSON from Google Cloud Console and save it here
# GOOGLE_CLIENT_FILE=credentials.json
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# FRONTEND_URL=http://localhost:5173

# --- Auth (optional; the app may generate its own secret if omitted) ---
# JWT_SECRET=replace_with_a_long_random_string

# --- Microsoft Teams (optional; add "teams" to ENABLED_SOURCES) ---
# TEAMS_CLIENT_ID=
# TEAMS_TENANT_ID=
